@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Mikkelhm.Models.CloudAlertsHome>
@using System.Globalization
@using Microsoft.Extensions.Logging
@using Mikkelhm.Core.CloudAlerts
@inject Microsoft.Extensions.Logging.ILogger<Mikkelhm.Models.CloudAlertsHome> Logger
@{
    Layout = null;

    var query = Context.Request.Query.ToDictionary(q => q.Key, q => (string?)q.Value.ToString(), StringComparer.OrdinalIgnoreCase);
    var filter = CloudAlertFilter.FromQuery(query);

    var alerts = new List<CloudAlertView>();
    foreach (var item in Model.Children<Mikkelhm.Models.CloudAlert>() ?? Enumerable.Empty<Mikkelhm.Models.CloudAlert>())
    {
        if (string.IsNullOrWhiteSpace(item.AlertId) || item.TimeFired is not { } timeFired || timeFired == default)
        {
            Logger.LogWarning("Skipping malformed cloud alert node {Key}", item.Key);
            continue;
        }

        alerts.Add(new CloudAlertView(
            item.Key,
            item.AlertId,
            item.ProjectAlias ?? "",
            item.ProjectUrl ?? "",
            item.EnvironmentName ?? "",
            item.AlertName ?? "",
            item.Details ?? "",
            item.Severity ?? "",
            item.CustomerMetadata ?? "",
            DateTime.SpecifyKind(timeFired, DateTimeKind.Utc),
            item.IsTest,
            item.RawPayload ?? ""));
    }

    var result = CloudAlertsQuery.Run(alerts, filter);
    var nowUtc = DateTime.UtcNow;
    var today = DateOnly.FromDateTime(CloudAlertsTime.ToLocal(nowUtc));
    var days = CloudAlertsTimeline.GroupByDay(result.Items, today);
    var title = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Name : Model.MetaTitle;
    var baseUrl = Model.Url();
    string PageUrl(CloudAlertFilter f) => baseUrl + f.ToQueryString();
    bool IsSelected(string? current, string value) => string.Equals(current, value, StringComparison.OrdinalIgnoreCase);
    bool IsHighlighted(string severity) => severity.Trim().ToLowerInvariant() is "high" or "critical";
    string SeverityLabel(string severity) => severity.Length == 0 ? "" : CultureInfo.InvariantCulture.TextInfo.ToTitleCase(severity.Trim().ToLowerInvariant());
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Sans+3:wght@400;600&display=swap" />
    <script>document.documentElement.classList.add('js');</script>
    <link rel="stylesheet" href="/cloudalerts/cloudalerts.css" />
</head>
<body>
    <main class="ca-page">
        <header class="ca-header">
            <h1>@title</h1>
            @if (result.TotalCount > 0)
            {
                <p class="ca-sub">@result.TotalCount @(result.TotalCount == 1 ? "alert" : "alerts") @CloudAlertsTimeline.RangeText(result.OldestUtc!.Value, result.NewestUtc!.Value)</p>
            }
            <p class="ca-zone">All times are Copenhagen time (@CloudAlertsTime.ZoneLabel(nowUtc))</p>
        </header>

        <form id="ca-filters" class="ca-filters" method="get" action="@baseUrl">
            <label>Project
                <select name="project">
                    <option value="">All</option>
                    @foreach (var v in result.Facets.Projects) { <option value="@v" selected="@IsSelected(filter.Project, v)">@v</option> }
                </select>
            </label>
            <label>Environment
                <select name="env">
                    <option value="">All</option>
                    @foreach (var v in result.Facets.Environments) { <option value="@v" selected="@IsSelected(filter.Environment, v)">@v</option> }
                </select>
            </label>
            <label>Alert
                <select name="alert">
                    <option value="">All</option>
                    @foreach (var v in result.Facets.AlertNames) { <option value="@v" selected="@IsSelected(filter.AlertName, v)">@v</option> }
                </select>
            </label>
            <label>Severity
                <select name="severity">
                    <option value="">All</option>
                    @foreach (var v in result.Facets.Severities) { <option value="@v" selected="@IsSelected(filter.Severity, v)">@v</option> }
                </select>
            </label>
            <label>From (Copenhagen)
                <input type="date" name="from" value="@filter.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
            </label>
            <label>To (Copenhagen)
                <input type="date" name="to" value="@filter.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
            </label>
            <label class="ca-search">Search
                <input type="search" name="q" value="@filter.Search" placeholder="details" />
            </label>
            <label class="ca-check"><input type="checkbox" name="tests" value="hide" checked="@(filter.Tests == TestAlertMode.Hide)" /> Hide test alerts</label>
            <div class="ca-actions">
                <button type="submit" class="ca-apply">Apply</button>
                <a href="@baseUrl">Reset</a>
            </div>
        </form>

        @if (filter.Tests == TestAlertMode.Only)
        {
            <p class="ca-note">Showing only test alerts. <a href="@PageUrl(filter with { Tests = TestAlertMode.Show, Page = 1 })">Show all alerts</a></p>
        }

        @if (days.Count == 0)
        {
            <p class="ca-empty">@(alerts.Count == 0 ? "No alerts received yet." : "No alerts match these filters.")</p>
        }
        else
        {
            foreach (var day in days)
            {
                <section class="ca-day">
                    <h2>@day.Heading</h2>
                    <ol class="ca-timeline">
                        @foreach (var entry in day.Entries)
                        {
                            var a = entry.Alert;
                            var severityLabel = SeverityLabel(a.Severity);
                            var context = string.Join(" · ", new[] { a.ProjectAlias, a.EnvironmentName, a.IsTest ? "test" : "" }.Where(p => p.Length > 0));
                            <li class="ca-entry @CloudAlertDisplay.SeverityClass(a.Severity)">
                                <time datetime="@a.TimeFiredUtc.ToString("O", CultureInfo.InvariantCulture)" title="@entry.LocalTime.ToString("dd-MM-yyyy HH:mm", CultureInfo.InvariantCulture) @CloudAlertsTime.Abbreviation(a.TimeFiredUtc)">@entry.LocalTime.ToString("HH:mm", CultureInfo.InvariantCulture)</time>
                                <div class="ca-body@(IsHighlighted(a.Severity) ? " ca-body--highlight" : "")">
                                    <div class="ca-meta">
                                        <strong>@a.AlertName</strong>
                                        @if (severityLabel.Length > 0) { <span class="ca-severity">@severityLabel</span> }
                                        <span class="ca-context">@context</span>
                                    </div>
                                    <p>@a.Details</p>
                                </div>
                            </li>
                        }
                    </ol>
                </section>
            }

            if (result.TotalPages > 1)
            {
                <nav class="ca-pager" aria-label="Pages">
                    @if (result.Page > 1) { <a href="@PageUrl(filter with { Page = result.Page - 1 })">‹ Newer</a> } else { <span></span> }
                    <span>Page @result.Page of @result.TotalPages</span>
                    @if (result.Page < result.TotalPages) { <a href="@PageUrl(filter with { Page = result.Page + 1 })">Older ›</a> } else { <span></span> }
                </nav>
            }
        }
    </main>

    <script src="/cloudalerts/cloudalerts.js"></script>
</body>
</html>
